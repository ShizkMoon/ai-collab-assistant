    {
      "index": 5,
      "content": "#!/bin/sh\nuci -q set ua3f.enabled.enabled=0\nuci -q commit ua3f\n[ -f \"/etc/config/ucitrack\" ] && {\n\tuci -q delete ucitrack.ua3f\n\tuci -q commit ucitrack\n}\n"
