# 本表仅归 ESurfing 专用 GID 路由所有；每次作为同一 nft 事务替换规则。
add table ip esurfing_route
flush table ip esurfing_route
add chain ip esurfing_route output { type route hook output priority -160; policy accept; }
add rule ip esurfing_route output meta skgid 65201 counter meta mark set 0x01000000 comment "esurfing account1 wan"
add rule ip esurfing_route output meta skgid 65202 counter meta mark set 0x02000000 comment "esurfing account2 wan2"
add rule ip esurfing_route output meta skgid 65203 counter meta mark set 0x03000000 comment "esurfing account3 wan3"
